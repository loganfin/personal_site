---
import ThemeToggle from './ThemeToggle.astro';
import MaintenancePage from './MaintenancePage.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

const maintenance = import.meta.env.PUBLIC_MAINTENANCE === 'true';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'loganfin.dev',
  description = 'Personal site with retro Gruvbox aesthetics',
  path,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const displayPath = path ?? `~/${pathname}`;

const rawSegments = displayPath.split('/').filter(Boolean);
const pathSegments = rawSegments.map((segment, index) => ({
  segment,
  href: index === 0 ? '/' : `/${rawSegments.slice(1, index + 1).join('/')}`,
  isLast: index === rawSegments.length - 1,
}));

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/loganfin',
    title: 'GitHub',
    hoverClass: 'hover:text-gruv-yellow',
    external: true,
    icon: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/loganfin',
    title: 'LinkedIn',
    hoverClass: 'hover:text-gruv-blue',
    external: true,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    name: 'RSS',
    href: '/rss.xml',
    title: 'RSS feed',
    hoverClass: 'hover:text-gruv-orange',
    external: false,
    icon: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  },
  {
    name: 'Email',
    href: 'mailto:mail@loganfin.dev',
    title: 'Email',
    hoverClass: 'hover:text-gruv-green',
    external: false,
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body
    class="min-h-screen min-w-[320px] bg-gruv-bg text-gruv-fg font-mono antialiased flex flex-col selection:bg-gruv-accent selection:text-gruv-bg-hard"
  >
    {
      maintenance ? (
        <MaintenancePage />
      ) : (
        <>
          <header class="border-b-2 border-gruv-border bg-gruv-bg-hard sticky top-0 z-50 shadow-md">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-x-4">
              <div
                class="flex-1 min-w-0 truncate group text-gruv-yellow font-bold text-base sm:text-lg"
                title={displayPath}
              >
                loganfin.dev
                <>
                  <span class="text-gruv-accent">:</span>
                  <span class="text-gruv-green font-extrabold">
                    {pathSegments.flatMap(({ segment, href, isLast }, index) => [
                      index > 0 ? <span class="opacity-50">/</span> : null,
                      isLast ? (
                        <span>{segment}</span>
                      ) : (
                        /* prettier-ignore */
                        <a href={href} class="hover:underline hover:text-gruv-yellow">{segment}</a>
                      ),
                    ])}
                  </span>
                </>
              </div>

              {/* Desktop Nav */}
              <nav class="hidden sm:flex items-center gap-2 sm:gap-4 text-xs sm:text-sm font-bold">
                <a
                  href="/"
                  class="px-2.5 py-1 rounded bg-gruv-card border border-gruv-border hover:border-gruv-yellow hover:text-gruv-yellow transition-all"
                >
                  ~/
                </a>
                <a
                  href="/blog"
                  class="px-2.5 py-1 rounded bg-gruv-card border border-gruv-border hover:border-gruv-green hover:text-gruv-green transition-all"
                >
                  ~/blog
                </a>
              </nav>

              <ThemeToggle />

              {/* Mobile hamburger menu toggle */}
              <button
                id="menu-toggle"
                type="button"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="p-2 sm:hidden rounded border border-gruv-border bg-gruv-card text-gruv-fg hover:text-gruv-yellow hover:border-gruv-yellow transition-all cursor-pointer"
              >
                <svg
                  id="menu-icon-open"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg
                  id="menu-icon-close"
                  class="w-5 h-5 hidden"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="m6 6 12 12M18 6 6 18" />
                </svg>
              </button>
            </div>

            {/* Mobile dropdown menu */}
            <div
              id="mobile-menu"
              class="hidden sm:hidden border-t border-gruv-border bg-gruv-bg-hard shadow-md"
            >
              <nav class="max-w-4xl mx-auto px-4 py-3 flex flex-col gap-3">
                <a
                  href="/"
                  class="px-3 py-2.5 rounded bg-gruv-card border border-gruv-border font-bold text-sm hover:border-gruv-yellow hover:text-gruv-yellow transition-all"
                >
                  ~/
                </a>
                <a
                  href="/blog"
                  class="px-3 py-2.5 rounded bg-gruv-card border border-gruv-border font-bold text-sm hover:border-gruv-green hover:text-gruv-green transition-all"
                >
                  ~/blog
                </a>
              </nav>
            </div>
          </header>

          <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
            <slot />
          </main>

          <footer class="border-t border-gruv-border bg-gruv-bg-hard text-gruv-fg-muted text-xs py-6 mt-12">
            <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
              <div class="font-mono">&copy; {new Date().getFullYear()} Logan Finley</div>
              <div class="flex items-center gap-5">
                {socialLinks.map(({ name, href, title, hoverClass, external, icon }) => (
                  <a
                    href={href}
                    title={title}
                    aria-label={name}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    class={`text-gruv-fg-muted ${hoverClass} transition-colors`}
                  >
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={icon}
                    />
                  </a>
                ))}
              </div>
            </div>
          </footer>
        </>
      )
    }

    <script>
      function initMobileMenu() {
        const toggleBtn = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');
        if (!toggleBtn || !menu || toggleBtn.dataset.bound) return;
        toggleBtn.dataset.bound = 'true';

        const setOpen = (open) => {
          menu.classList.toggle('hidden', !open);
          toggleBtn.setAttribute('aria-expanded', String(open));
          toggleBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          iconOpen?.classList.toggle('hidden', open);
          iconClose?.classList.toggle('hidden', !open);
        };

        toggleBtn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
        menu.addEventListener('click', (event) => {
          if (event.target.closest('a')) setOpen(false);
        });
        document.addEventListener('click', (event) => {
          if (!event.target.closest('header')) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      }

      initMobileMenu();
      document.addEventListener('astro:after-swap', initMobileMenu);
    </script>
  </body>
</html>
