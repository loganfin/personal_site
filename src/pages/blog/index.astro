---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Layout>
  <section class="space-y-6">
    <div class="border-b-2 border-gruv-border pb-4">
      <h1 class="text-3xl font-extrabold text-gruv-yellow mb-2">Posts</h1>
    </div>

    <div class="space-y-4">
      {
        sortedPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="border border-gruv-border bg-gruv-card p-5 rounded-lg hover:border-gruv-yellow hover:bg-gruv-card-hover transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4 group focus:outline-none"
          >
            <div class="space-y-1">
              <time
                datetime={post.data.date.toISOString().split('T')[0]}
                class="text-xs text-gruv-fg-muted font-mono block"
              >
                {formatDate(post.data.date)}
              </time>
              <h2 class="text-lg font-bold text-gruv-fg-bright group-hover:text-gruv-yellow transition-colors">
                {post.data.title}
              </h2>
            </div>

            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded border border-gruv-border bg-gruv-bg-hard text-gruv-accent group-hover:border-gruv-accent group-hover:text-gruv-yellow transition-all w-fit shrink-0">
              <span>READ POST</span>
              <span>&rarr;</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
