---
import Layout from '../../components/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${post.data.title} — Finlo's Blog`} path={`~/blog/${post.data.title}`}>
  <article class="space-y-6">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-bold text-gruv-accent hover:text-gruv-yellow transition-colors mb-2"
    >
      <span>&larr;</span>
      <span>BACK TO ALL POSTS</span>
    </a>

    <header class="border-b-2 border-gruv-border pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gruv-yellow mb-3">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-xs text-gruv-fg-muted font-mono">
        <span>PUBLISHED: {formatDate(post.data.date)}</span>
      </div>
    </header>

    <div class="prose-gruv">
      <Content />
    </div>
  </article>
</Layout>
